{
  "expo": {
    "name": "Pratihari",
    "slug": "pratihari",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF9"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFFDF9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.x33croresdev.pratihari",
      "googleServicesFile": "./android/app/google-services.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55e88d37-98c8-4a8f-b86e-b1f1aa49fa92"
      }
    },
    "owner": "33croresdev"
  }
}
